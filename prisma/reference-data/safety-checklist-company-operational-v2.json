    { "code": "RP-001", "sourceNumber": 1, "sourceText": "1. Phương tiện bảo vệ bảo hộ cá nhân.", "normalizedLabel": "Phương tiện bảo hộ cá nhân", "sortOrder": 10, "requiresBusinessClarification": false, "blocksCompletion": true, "isScored": true, "mappingItemCodes": ["OP-PPE-001"] },
    { "code": "RP-002", "sourceNumber": 2, "sourceText": "2. Thiết bị bảo hộ làm việc trên cao (Dây đai, mũ, lưới, hệ thống điểm neo…).", "normalizedLabel": "Thiết bị bảo hộ làm việc trên cao", "sortOrder": 20, "requiresBusinessClarification": false, "blocksCompletion": true, "isScored": true, "mappingItemCodes": ["OP-HEIGHT-001", "OP-HEIGHT-004", "OP-HEIGHT-005"] },
    { "code": "RP-003", "sourceNumber": 3, "sourceText": "3. An toàn thang và lối đi lại: Kiểm tra độ an toàn của thang; hướng dẫn công nhân và Chỉ huy đảm bảo các lối lên xuống, lối đi lại chắc chắn.", "normalizedLabel": "An toàn thang, lối lên xuống và lối đi lại", "sortOrder": 30, "requiresBusinessClarification": false, "blocksCompletion": true, "isScored": true, "mappingItemCodes": ["OP-ACCESS-001"] },
    { "code": "RP-004", "sourceNumber": 4, "sourceText": "4. Hệ thống giàn giáo.", "normalizedLabel": "Hệ thống giàn giáo", "sortOrder": 40, "requiresBusinessClarification": false, "blocksCompletion": true, "isScored": true, "mappingItemCodes": ["OP-HEIGHT-002"] },
    { "code": "RP-005", "sourceNumber": 5, "sourceText": "5. Lưới bao che: Chắn vật liệu rơi, chống bụi và kiểm tra độ võng của lưới", "normalizedLabel": "Lưới bao che, chống vật rơi và chống bụi", "sortOrder": 50, "requiresBusinessClarification": false, "blocksCompletion": true, "isScored": true, "mappingItemCodes": ["OP-HEIGHT-003"] },
    { "code": "RP-006", "sourceNumber": 6, "sourceText": "6. Khu vực nguy hiểm: Hố đào sâu, lỗ mở, hố ga... (Lắp đặt rào chắn và hệ thống văng chống hố đào).", "normalizedLabel": "Hố đào, lỗ mở, hố ga, rào chắn và văng chống", "sortOrder": 60, "requiresBusinessClarification": false, "blocksCompletion": true, "isScored": true, "mappingItemCodes": ["OP-HEIGHT-005", "OP-HEIGHT-006", "OP-EXC-001", "OP-EXC-002"] },
    { "code": "RP-007", "sourceNumber": 7, "sourceText": "7. Công việc phát sinh nhiệt: (Hàn, cắt, mối nối... đảm bảo an toàn cháy nổ).", "normalizedLabel": "Hàn, cắt và công việc phát sinh nhiệt", "sortOrder": 70, "requiresBusinessClarification": false, "blocksCompletion": true, "isScored": true, "mappingItemCodes": ["OP-FIRE-001"] },
    { "code": "RP-008", "sourceNumber": 8, "sourceText": "8. Công việc ngày", "normalizedLabel": "Nội dung theo mẫu “Công việc ngày” đang chờ xác nhận", "sortOrder": 80, "requiresBusinessClarification": true, "blocksCompletion": false, "isScored": false, "mappingItemCodes": [] },
    { "code": "RP-009", "sourceNumber": 9, "sourceText": "9. Dụng cụ, máy móc, thiết bị: (Kiểm tra độ an toàn và tình trạng vận hành).", "normalizedLabel": "An toàn và tình trạng vận hành của dụng cụ, máy móc, thiết bị", "sortOrder": 90, "requiresBusinessClarification": false, "blocksCompletion": true, "isScored": true, "mappingItemCodes": ["OP-MACH-001", "OP-MACH-002", "OP-MACH-003", "OP-MACH-004"] },
    { "code": "RP-010", "sourceNumber": 10, "sourceText": "10. Lối đi lại và thoát hiểm: Đảm bảo lối đi thông thoáng, không để vật liệu cản trở để xử lý kịp thời khi có sự cố.", "normalizedLabel": "Lối đi lại và lối thoát hiểm", "sortOrder": 100, "requiresBusinessClarification": false, "blocksCompletion": true, "isScored": true, "mappingItemCodes": ["OP-ACCESS-002"] },
    { "code": "RP-011", "sourceNumber": 11, "sourceText": "11. Vệ sinh công trình", "normalizedLabel": "Vệ sinh công trình", "sortOrder": 110, "requiresBusinessClarification": false, "blocksCompletion": true, "isScored": true, "mappingItemCodes": ["OP-ENV-001"] },
    { "code": "RP-012", "sourceNumber": 12, "sourceText": "12. Thiết bị và biển báo PCCC: Kiểm tra số lượng, vị trí lắp đặt và tình trạng hoạt động.", "normalizedLabel": "Thiết bị và biển báo PCCC", "sortOrder": 120, "requiresBusinessClarification": false, "blocksCompletion": true, "isScored": true, "mappingItemCodes": ["OP-FIRE-002"] },
    { "code": "RP-013", "sourceNumber": 13, "sourceText": "13. Hệ thống biển báo nội quy và cảnh báo: Đảm bảo treo đầy đủ tại: Ban chỉ huy, khu vực làm việc trên cao, tủ điện, khu vực nguy hiểm (cấm tiếp cận khi có thi công phía trên cao), biển cảnh báo giao thông, đèn tín hiệu và đèn phản quang.", "normalizedLabel": "Biển báo nội quy, cảnh báo, đèn tín hiệu và phản quang", "sortOrder": 130, "requiresBusinessClarification": false, "blocksCompletion": true, "isScored": true, "mappingItemCodes": ["OP-SIGN-001"] },
    { "code": "RP-014", "sourceNumber": 14, "sourceText": "14. Sinh hoạt của công nhân: Kiểm tra an toàn điện sinh hoạt, vệ sinh môi trường nơi ăn ở và lắp đặt đầy đủ biển cảnh báo tại khu vực lưu trú.", "normalizedLabel": "An toàn, vệ sinh khu ăn ở và lưu trú của công nhân", "sortOrder": 140, "requiresBusinessClarification": false, "blocksCompletion": true, "isScored": true, "mappingItemCodes": ["OP-ELEC-004", "OP-ENV-002", "OP-SIGN-001"] },
    { "code": "RP-015", "sourceNumber": 15, "sourceText": "15. Hệ thống điện thi công: Đảm bảo dây dẫn được treo cao, tủ điện đấu nối đúng kỹ thuật; kiểm tra an toàn các ổ cắm và dây nguồn của thiết bị cầm tay.", "normalizedLabel": "Dây dẫn, tủ điện, ổ cắm và nguồn thiết bị cầm tay", "sortOrder": 150, "requiresBusinessClarification": false, "blocksCompletion": true, "isScored": true, "mappingItemCodes": ["OP-ELEC-001", "OP-ELEC-002", "OP-ELEC-003", "OP-ELEC-004", "OP-ELEC-005"] },
