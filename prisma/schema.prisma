generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ENUMS
enum UserRole {
  ADMIN
  DIRECTOR
  DEPUTY_DIRECTOR
  CHIEF_COMMANDER
  MANAGER
  ENGINEER
  STAFF
  SUPERVISION_HEAD
  CONSTRUCTION_SUPERVISOR
}

enum ProjectRole {
  PROJECT_MANAGER
  SITE_COMMANDER
  CHIEF_COMMANDER
  ASSISTANT_COMMANDER
  QA_QC
  HSE
  SUPERVISOR
  VIEWER
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum MaterialMovementType {
  IMPORT
  EXPORT
  TRANSFER
  RETURN
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalRequestType {
  MATERIAL
  REPORT
  VOLUME
  INSPECTION
  PLAN
  DRAWING
  METHOD_STATEMENT
  SAFETY
  QUALITY
  SITE_ISSUE
  CHANGE_ORDER
  OTHER
}

enum ApprovalPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SiteReportStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  REVISION_REQUESTED
  LOCKED
  CANCELLED
}

enum SiteReportType {
  DAILY
  WEEKLY
}

enum WeatherCondition {
  SUNNY
  CLOUDY
  OVERCAST
  LIGHT_RAIN
  HEAVY_RAIN
  WINDY
  STORM
  OTHER
}

enum SiteReportAttachmentKind {
  PHOTO
  FILE
}

enum WBSItemStatus {
  PLANNED
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
}

enum MaterialRequestStatus {
  DRAFT
  REQUESTED
  SUBMITTED
  APPROVED
  REJECTED
  PROCESSING
  ISSUED
  RECEIVED
  CANCELLED
}

enum MaterialRequestPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum FieldProgressItemType {
  GROUP
  WORK
  NOTE
}

enum FieldProgressItemAssignmentRole {
  RESPONSIBLE
  COORDINATOR
}

enum ProjectLocationNodeType {
  PROJECT
  ZONE
  BLOCK
  BUILDING
  BASEMENT
  FLOOR
  AREA
  ROOM
  AXIS
  ELEVATION
  OTHER
}

enum FieldProgressItemStatus {
  PLANNED
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
}

enum FieldProgressEntryStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REVISION_REQUESTED
  CANCELLED
}

enum FieldMaterialRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  ISSUED
  RECEIVED
  CANCELLED
}

enum FieldMaterialPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DocumentStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  ARCHIVED
  SUPERSEDED
}

// Work Management Phase 1 keeps the read projection queryable while the
// canonical CoreTask aggregate and append-only action payloads are retained
// as JSON snapshots. This is additive to the existing ERP schema.
enum WorkTaskIdempotencyState {
  IN_PROGRESS
  COMPLETED
}

// MODELS

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  username  String?   @unique
  password  String
  name      String
  role      UserRole  @default(STAFF)
  phone     String?
  avatar    String?
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  projectMembers               ProjectMember[]
  assignedProjectMembers       ProjectMember[]               @relation("ProjectMemberAssigner")
  auditLogs                    AuditLog[]
  messages                     ChatMessage[]
  createdSiteReports           SiteReport[]                  @relation("ReportCreator")
  approvedSiteReports          SiteReport[]                  @relation("ReportApprover")
  createdWBSItems              WBSItem[]
  materialRequests             MaterialRequest[]
  approvalRequests             ApprovalRequest[]             @relation("Requester")
  approvals                    ApprovalRequest[]             @relation("Approver")
  documents                    Document[]
  createdFieldTemplates        FieldProgressTemplate[]       @relation("FieldTemplateCreator")
  createdFieldItems            FieldProgressItem[]           @relation("FieldItemCreator")
  createdFieldEntries          FieldProgressEntry[]          @relation("FieldEntryCreator")
  approvedFieldEntries         FieldProgressEntry[]          @relation("FieldEntryApprover")
  fieldMaterialRequests        FieldMaterialRequest[]        @relation("FieldMaterialRequester")
  updatedSettings              SystemSetting[]               @relation("SettingUpdater")
  notifications                Notification[]
  createdWorkTasks             WorkTask[]                    @relation("WorkTaskCreator")
  assignedWorkTasks            WorkTask[]                    @relation("WorkTaskPrimaryAssignee")
  reviewedWorkTasks            WorkTask[]                    @relation("WorkTaskReviewer")
  approvedWorkTasks            WorkTask[]                    @relation("WorkTaskApprover")
  workTaskActions              WorkTaskAction[]              @relation("WorkTaskActionActor")
  createdLocationNodes         ProjectLocationNode[]         @relation("ProjectLocationNodeCreator")
  updatedLocationNodes         ProjectLocationNode[]         @relation("ProjectLocationNodeUpdater")
  fieldProgressItemAssignments FieldProgressItemAssignment[] @relation("FieldProgressItemAssignmentActor")

  supervisionWeeklyPackagesCreated  SupervisionWeeklyPackage[]      @relation("SupervisionWeeklyPackage_createdByIdToUser")
  supervisionWeeklyPackagesReviewed SupervisionWeeklyPackage[]      @relation("SupervisionWeeklyPackage_reviewedByIdToUser")
  supervisionFindingsCreated        SupervisionFinding[]
  supervisionScope                  SupervisionScope?
  supervisionVisitsCreated          SupervisionVisit[]
  supervisionWorkflowHistories      SupervisionWorkflowHistory[]
  supervisionInspectionSchedules    SupervisionInspectionSchedule[]
  supervisionWeeklyDossiersCreated  SupervisionWeeklyDossier[]      @relation("SupervisionWeeklyDossierCreator")
  supervisionWeeklyDossiersReviewed SupervisionWeeklyDossier[]      @relation("SupervisionWeeklyDossierReviewer")
  supervisionWeeklyRevisionActors   SupervisionWeeklyRevision[]     @relation("SupervisionWeeklyRevisionActor")

  safetyPlansCreated               SafetyInspectionPlan[]                 @relation("SafetyPlanCreator")
  safetyPlansApproved              SafetyInspectionPlan[]                 @relation("SafetyPlanApprover")
  safetyPlanProjectsAdded          SafetyInspectionPlanProject[]          @relation("SafetyPlanProjectAddedBy")
  safetyScheduleCollaborations     SafetyInspectionScheduleCollaborator[]
  safetySessionsInspected          SafetyInspectionSession[]              @relation("SafetySessionInspector")
  safetyChecklistTemplatesCreated  SafetyChecklistTemplate[]              @relation("SafetyChecklistTemplateCreator")
  safetyResultsInspected           SafetyInspectionResult[]               @relation("SafetyResultInspector")
  safetyFindingsCreated            SafetyFinding[]                        @relation("SafetyFindingCreator")
  safetyFindingsResponsible        SafetyFinding[]                        @relation("SafetyFindingResponsibleUser")
  safetyCorrectiveActionsCreated   SafetyCorrectiveAction[]               @relation("SafetyCorrectiveActionCreator")
  safetyCorrectiveActionsAssigned  SafetyCorrectiveAction[]               @relation("SafetyCorrectiveActionAssignee")
  safetyCorrectiveActionsSubmitted SafetyCorrectiveAction[]               @relation("SafetyCorrectiveActionSubmitter")
  safetyEvidenceUploaded           SafetyCorrectiveEvidence[]             @relation("SafetyEvidenceUploader")
  safetyEvidenceCancelled          SafetyCorrectiveEvidence[]             @relation("SafetyEvidenceCanceller")
  safetyReinspectionsPerformed     SafetyReinspection[]                   @relation("SafetyReinspectionInspector")
  safetyWeeklyReportsCreated       SafetyWeeklyReport[]                   @relation("SafetyWeeklyReportCreator")
  safetyWeeklyReportsApproved      SafetyWeeklyReport[]                   @relation("SafetyWeeklyReportApprover")
  safetyWeeklyNarrativesEdited     SafetyWeeklyReportNarrative[]          @relation("SafetyWeeklyNarrativeEditor")
  safetyWeeklyEntriesCancelled     SafetyWeeklyReportEntry[]              @relation("SafetyWeeklyReportEntryCanceller")
  safetyDocumentTemplatesCreated   SafetyDocumentTemplate[]               @relation("SafetyDocumentTemplateCreator")
  safetyDocumentTemplatesApproved  SafetyDocumentTemplate[]               @relation("SafetyDocumentTemplateApprover")
  safetyApprovalHistoryActions     SafetyApprovalHistory[]                @relation("SafetyApprovalActor")
  safetyAuditLogActions            SafetyAuditLog[]                       @relation("SafetyAuditActor")
  safetyIdempotencyMutations       SafetyIdempotency[]                    @relation("SafetyIdempotencyActor")

  @@index([email])
  @@index([username])
  @@index([createdAt])
}

model Project {
  id          String        @id @default(cuid())
  code        String        @unique
  name        String
  description String?
  investor    String?
  location    String?
  status      ProjectStatus @default(PLANNING)
  startDate   DateTime?
  endDate     DateTime?
  budget      Decimal?      @db.Decimal(19, 4)
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  members                      ProjectMember[]
  wbsItems                     WBSItem[]
  documentFolders              DocumentFolder[]
  siteReports                  SiteReport[]
  siteReportLines              SiteReportLine[]
  materialMovements            MaterialMovement[]
  materialRequests             MaterialRequest[]
  documents                    Document[]
  fieldProgressTemplates       FieldProgressTemplate[]
  fieldProgressItems           FieldProgressItem[]
  fieldProgressEntries         FieldProgressEntry[]
  fieldMaterialRequests        FieldMaterialRequest[]
  projectMaterialStocks        ProjectMaterialStock[]
  materialItems                MaterialItem[]
  approvalRequests             ApprovalRequest[]
  notifications                Notification[]
  workTasks                    WorkTask[]
  locationNodes                ProjectLocationNode[]
  fieldProgressItemAssignments FieldProgressItemAssignment[]
  fieldProgressItemLocations   FieldProgressItemLocation[]

  supervisionFindings              SupervisionFinding[]
  supervisionPlanItems             SupervisionPlanItem[]
  supervisionProgressAssessments   SupervisionProgressAssessment[]
  supervisionQuantityVerifications SupervisionQuantityVerification[]
  supervisionRecommendations       SupervisionRecommendation[]
  supervisionScopeProjects         SupervisionScopeProject[]
  supervisionTransitionChecks      SupervisionTransitionCheck[]
  supervisionVisits                SupervisionVisit[]
  supervisionInspectionSchedules   SupervisionInspectionSchedule[]
  supervisionWeeklyEntries         SupervisionWeeklyEntry[]
  supervisionWeeklyQuantities      SupervisionWeeklyQuantity[]
  supervisionWeeklyTransitions     SupervisionWeeklyTransition[]
  supervisionWeeklyProgressRows    SupervisionWeeklyProgress[]
  supervisionWeeklyObservations    SupervisionWeeklyObservation[]

  safetyPlanProjects         SafetyInspectionPlanProject[]
  safetySchedules            SafetyInspectionSchedule[]
  safetySessions             SafetyInspectionSession[]
  safetyInspectionResults    SafetyInspectionResult[]
  safetyFindings             SafetyFinding[]
  safetyCorrectiveActions    SafetyCorrectiveAction[]
  safetyCorrectiveEvidence   SafetyCorrectiveEvidence[]
  safetyReinspections        SafetyReinspection[]
  safetyWeeklyReportProjects SafetyWeeklyReportProject[]
  safetyWeeklyReportEntries  SafetyWeeklyReportEntry[]
  safetyApprovalHistories    SafetyApprovalHistory[]
  safetyAuditLogs            SafetyAuditLog[]

  @@index([code])
  @@index([status])
  @@index([createdAt])
}

model WorkTask {
  id                String    @id @default(cuid())
  projectId         String
  creatorId         String
  primaryAssigneeId String?
  reviewerId        String?
  approverId        String?
  title             String
  description       String?
  priority          String    @default("NORMAL")
  confidentiality   String    @default("NORMAL")
  lifecycle         String
  acceptance        String
  execution         String
  review            String
  handover          String
  waitingReason     String?
  deadlineAt        DateTime?
  progressPercent   Int       @default(0)
  version           Int       @default(1)
  snapshot          Json
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  project         Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator         User                    @relation("WorkTaskCreator", fields: [creatorId], references: [id])
  primaryAssignee User?                   @relation("WorkTaskPrimaryAssignee", fields: [primaryAssigneeId], references: [id])
  reviewer        User?                   @relation("WorkTaskReviewer", fields: [reviewerId], references: [id])
  approver        User?                   @relation("WorkTaskApprover", fields: [approverId], references: [id])
  actions         WorkTaskAction[]
  outboxMessages  WorkTaskOutboxMessage[]
  idempotencyRows WorkTaskIdempotency[]

  @@index([projectId, updatedAt])
  @@index([primaryAssigneeId, updatedAt])
  @@index([creatorId, updatedAt])
  @@index([lifecycle, updatedAt])
}

model WorkTaskAction {
  id         String   @id @default(cuid())
  taskId     String
  action     String
  actorId    String
  version    Int
  occurredAt DateTime
  effects    Json
  createdAt  DateTime @default(now())

  task  WorkTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User     @relation("WorkTaskActionActor", fields: [actorId], references: [id])

  @@index([taskId, occurredAt])
  @@index([actorId, occurredAt])
}

model WorkTaskOutboxMessage {
  id               String   @id @default(cuid())
  taskId           String
  action           String
  aggregateVersion Int
  idempotencyKey   String
  message          Json
  occurredAt       DateTime
  createdAt        DateTime @default(now())

  task WorkTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, aggregateVersion])
  @@index([idempotencyKey])
}

model WorkTaskIdempotency {
  id          String                   @id @default(cuid())
  key         String
  scopeKey    String
  action      String
  actorId     String
  projectId   String?
  taskId      String?
  fingerprint String
  state       WorkTaskIdempotencyState
  result      Json?
  createdAt   DateTime                 @default(now())
  completedAt DateTime?

  task WorkTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@unique([key, scopeKey])
  @@index([taskId])
  @@index([actorId, projectId])
}

model ProjectMember {
  id           String      @id @default(cuid())
  projectId    String
  userId       String
  role         ProjectRole
  assignedById String?
  isActive     Boolean     @default(true)
  note         String?
  joinedAt     DateTime    @default(now())
  leftAt       DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  project                      Project                       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user                         User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedBy                   User?                         @relation("ProjectMemberAssigner", fields: [assignedById], references: [id])
  fieldProgressItemAssignments FieldProgressItemAssignment[]

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@index([assignedById])
}

model WBSItem {
  id               String        @id @default(cuid())
  projectId        String
  parentId         String?
  code             String
  name             String
  unit             String        @default("Lần")
  designQuantity   Decimal?      @db.Decimal(19, 4)
  description      String?
  plannedStartDate DateTime?
  plannedEndDate   DateTime?
  progress         Decimal       @default(0) @db.Decimal(5, 2)
  budget           Decimal?      @db.Decimal(19, 4)
  status           WBSItemStatus @default(PLANNED)
  note             String?
  createdById      String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  project              Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent               WBSItem?              @relation("WBSHierarchy", fields: [parentId], references: [id])
  children             WBSItem[]             @relation("WBSHierarchy")
  createdBy            User?                 @relation(fields: [createdById], references: [id])
  siteReportLines      SiteReportLine[]
  materialRequestItems MaterialRequestItem[]

  @@unique([projectId, code])
  @@index([projectId])
  @@index([parentId])
}

model DocumentFolder {
  id        String    @id @default(cuid())
  projectId String
  parentId  String?
  name      String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent    DocumentFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id])
  children  DocumentFolder[] @relation("FolderHierarchy")
  documents Document[]

  @@index([projectId])
  @@index([parentId])
}

model Document {
  id                  String         @id @default(cuid())
  projectId           String
  folderId            String
  originalName        String
  storedName          String
  mimeType            String
  extension           String
  size                Int
  storagePath         String
  uploadedById        String
  displayName         String?
  documentType        String?
  status              DocumentStatus @default(SUBMITTED)
  metadata            Json?
  fileHash            String?
  reviewedById        String?
  reviewedAt          DateTime?
  rejectedReason      String?
  fieldProgressItemId String?
  locationNodeId      String?
  version             Int            @default(1)
  deletedAt           DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  project           Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder            DocumentFolder       @relation(fields: [folderId], references: [id], onDelete: Cascade)
  uploadedBy        User                 @relation(fields: [uploadedById], references: [id])
  fieldProgressItem FieldProgressItem?   @relation(fields: [fieldProgressItemId], references: [id])
  locationNode      ProjectLocationNode? @relation(fields: [locationNodeId], references: [id])
  safetyEvidence SafetyCorrectiveEvidence[]
  safetyTemplates SafetyDocumentTemplate[]

  @@index([projectId])
  @@index([folderId])
  @@index([uploadedById])
  @@index([status])
  @@index([documentType])
  @@index([fileHash])
  @@index([folderId, status])
  @@index([fieldProgressItemId])
  @@index([locationNodeId])
}

model SiteReport {
  id                 String            @id @default(cuid())
  reportNo           String            @unique @default(dbgenerated("(gen_random_uuid())::text"))
  type               SiteReportType    @default(DAILY)
  projectId          String
  title              String?
  reportDate         DateTime
  weekStartDate      DateTime?
  weekEndDate        DateTime?
  weatherCondition   WeatherCondition?
  weatherTemperature Float?
  weatherNote        String?
  gpsLat             Float?
  gpsLng             Float?

  summary         String? @db.Text
  materials       String? @db.Text
  labor           String? @db.Text
  equipment       String? @db.Text
  quality         String? @db.Text
  issues          String? @db.Text
  recommendations String? @db.Text

  reporterName String?

  // Legacy fields
  weather       String?
  manpowerCount Int?
  equipmentNote String?
  generalNote   String?

  status         SiteReportStatus @default(DRAFT)
  createdById    String
  submittedAt    DateTime?
  approvedById   String?
  approvedAt     DateTime?
  rejectedReason String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  project          Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy        User                   @relation("ReportCreator", fields: [createdById], references: [id])
  approvedBy       User?                  @relation("ReportApprover", fields: [approvedById], references: [id])
  photos           SiteReportPhoto[]
  attachments      SiteReportAttachment[]
  lines            SiteReportLine[]
  materialRequests MaterialRequest[]

  @@index([projectId])
  @@index([createdById])
  @@index([reportDate])
}

model SiteReportPhoto {
  id          String   @id @default(cuid())
  reportId    String
  storageKey  String
  description String?
  createdAt   DateTime @default(now())

  report SiteReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

model SiteReportAttachment {
  id           String                   @id @default(cuid())
  reportId     String
  kind         SiteReportAttachmentKind @default(FILE)
  fileName     String
  originalName String?
  mimeType     String
  sizeBytes    Int
  storagePath  String
  publicUrl    String?
  caption      String?
  createdAt    DateTime                 @default(now())

  report SiteReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

model SiteReportLine {
  id                  String    @id @default(cuid())
  siteReportId        String
  projectId           String
  wbsItemId           String?
  fieldProgressItemId String?
  locationNodeId      String?
  workName            String?
  workContent         String
  area                String?
  constructionCrew    String?
  unit                String?
  designQuantity      Decimal?  @db.Decimal(19, 4)
  quantityToday       Decimal   @db.Decimal(19, 4)
  quantityBefore      Decimal   @default(0) @db.Decimal(19, 4)
  quantityCumulative  Decimal   @default(0) @db.Decimal(19, 4)
  progressPercent     Decimal   @default(0) @db.Decimal(5, 2)
  note                String?
  issueNote           String?
  proposalNote        String?
  sortOrder           Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  siteReport        SiteReport           @relation(fields: [siteReportId], references: [id], onDelete: Cascade)
  project           Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wbsItem           WBSItem?             @relation(fields: [wbsItemId], references: [id])
  fieldProgressItem FieldProgressItem?   @relation(fields: [fieldProgressItemId], references: [id])
  locationNode      ProjectLocationNode? @relation(fields: [locationNodeId], references: [id])

  @@index([siteReportId])
  @@index([projectId])
  @@index([wbsItemId])
  @@index([fieldProgressItemId])
  @@index([locationNodeId])
}

model MaterialRequest {
  id            String                  @id @default(cuid())
  projectId     String
  requestNo     String                  @unique
  siteReportId  String?
  requestedById String
  requestDate   DateTime
  neededDate    DateTime?
  status        MaterialRequestStatus   @default(DRAFT)
  priority      MaterialRequestPriority @default(MEDIUM)
  note          String?
  cancelReason  String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  deletedAt     DateTime?

  project     Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  siteReport  SiteReport?           @relation(fields: [siteReportId], references: [id])
  requestedBy User                  @relation(fields: [requestedById], references: [id])
  items       MaterialRequestItem[]
  movements   MaterialMovement[]

  @@index([projectId])
  @@index([requestNo])
  @@index([siteReportId])
  @@index([requestedById])
}

model MaterialRequestItem {
  id                   String    @id @default(cuid())
  materialRequestId    String
  wbsItemId            String?
  fieldProgressItemId  String?
  workItemNameSnapshot String?
  materialCode         String?
  materialName         String
  unit                 String
  requestedQuantity    Decimal   @db.Decimal(19, 4)
  issuedQuantity       Decimal   @default(0) @db.Decimal(19, 4)
  receivedQuantity     Decimal   @default(0) @db.Decimal(19, 4)
  remainingQuantity    Decimal   @default(0) @db.Decimal(19, 4)
  reason               String?
  note                 String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?
  locationNodeId       String?

  materialRequest   MaterialRequest      @relation(fields: [materialRequestId], references: [id], onDelete: Cascade)
  wbsItem           WBSItem?             @relation(fields: [wbsItemId], references: [id])
  fieldProgressItem FieldProgressItem?   @relation(fields: [fieldProgressItemId], references: [id])
  movements         MaterialMovement[]
  locationNode      ProjectLocationNode? @relation(fields: [locationNodeId], references: [id])

  @@index([materialRequestId])
  @@index([wbsItemId])
  @@index([fieldProgressItemId])
  @@index([locationNodeId])
}

model MaterialItem {
  id          String   @id @default(cuid())
  projectId   String
  code        String
  name        String
  unit        String
  group       String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project       Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  movements     MaterialMovement[]
  projectStocks ProjectMaterialStock[]

  @@unique([projectId, code])
  @@index([projectId])
}

model MaterialMovement {
  id                    String               @id @default(cuid())
  projectId             String
  materialItemId        String
  materialRequestId     String?
  materialRequestItemId String?
  materialCodeSnapshot  String?
  materialNameSnapshot  String?
  unitSnapshot          String?
  type                  MaterialMovementType
  quantity              Decimal              @db.Decimal(19, 4)
  unitPrice             Decimal?             @db.Decimal(19, 4)
  movementDate          DateTime
  notes                 String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  project             Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  materialItem        MaterialItem         @relation(fields: [materialItemId], references: [id])
  materialRequest     MaterialRequest?     @relation(fields: [materialRequestId], references: [id], onDelete: SetNull)
  materialRequestItem MaterialRequestItem? @relation(fields: [materialRequestItemId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([materialItemId])
  @@index([materialRequestId])
  @@index([materialRequestItemId])
  @@index([projectId, materialItemId])
  @@index([projectId, movementDate])
  @@index([movementDate])
}

model ProjectMaterialStock {
  id             String   @id @default(cuid())
  projectId      String
  materialItemId String
  stock          Decimal  @default(0) @db.Decimal(19, 4)
  minStockLevel  Decimal  @default(0) @db.Decimal(19, 4)
  lastUpdated    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  materialItem MaterialItem @relation(fields: [materialItemId], references: [id], onDelete: Cascade)

  @@unique([projectId, materialItemId])
  @@index([projectId])
  @@index([materialItemId])
}

model ApprovalRequest {
  id           String                @id @default(cuid())
  code         String                @unique
  projectId    String
  title        String
  description  String?
  type         ApprovalRequestType   @default(OTHER)
  status       ApprovalRequestStatus @default(PENDING)
  priority     ApprovalPriority      @default(NORMAL)
  dueDate      DateTime?
  requesterId  String
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?
  sourceType   String?
  sourceId     String?
  entityType   String
  entityId     String
  deletedAt    DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requester User    @relation("Requester", fields: [requesterId], references: [id])
  decidedBy User?   @relation("Approver", fields: [decidedById], references: [id])
  safetyHistories SafetyApprovalHistory[]

  @@index([projectId])
  @@index([requesterId])
  @@index([decidedById])
  @@index([status])
  @@index([type])
  @@index([priority])
  @@index([sourceType, sourceId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String?
  projectId String?
  type      String
  severity  String    @default("INFO") // INFO, WARNING, ERROR, SUCCESS
  title     String
  message   String?
  href      String?
  isRead    Boolean   @default(false)
  createdAt DateTime  @default(now())
  readAt    DateTime?

  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([projectId, createdAt])
}

model ChatMessage {
  id        String   @id @default(cuid())
  senderId  String
  content   String
  createdAt DateTime @default(now())

  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  projectId  String?
  action     String
  entityType String
  entityId   String
  beforeData String?  @db.Text
  afterData  String?  @db.Text
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model FieldProgressTemplate {
  id          String    @id @default(cuid())
  projectId   String
  name        String
  description String?
  status      String    @default("ACTIVE")
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  project          Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy        User                   @relation("FieldTemplateCreator", fields: [createdById], references: [id])
  items            FieldProgressItem[]
  entries          FieldProgressEntry[]
  materialRequests FieldMaterialRequest[]

  @@index([projectId])
}

model FieldProgressItem {
  id               String                  @id @default(cuid())
  projectId        String
  templateId       String
  parentId         String?
  sortOrder        Int                     @default(0)
  level            Int                     @default(0)
  itemType         FieldProgressItemType   @default(WORK)
  code             String?
  categoryName     String?
  workContent      String?
  constructionCrew String?
  designQuantity   Decimal?                @db.Decimal(19, 4)
  unit             String?
  status           FieldProgressItemStatus @default(PLANNED)
  isLocked         Boolean                 @default(false)
  note             String?
  createdById      String
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  deletedAt        DateTime?

  project              Project                       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  template             FieldProgressTemplate         @relation(fields: [templateId], references: [id], onDelete: Cascade)
  parent               FieldProgressItem?            @relation("FieldItemHierarchy", fields: [parentId], references: [id])
  children             FieldProgressItem[]           @relation("FieldItemHierarchy")
  createdBy            User                          @relation("FieldItemCreator", fields: [createdById], references: [id])
  entries              FieldProgressEntry[]
  materialRequests     FieldMaterialRequest[]
  materialRequestItems MaterialRequestItem[]
  siteReportLines      SiteReportLine[]
  documents            Document[]
  assignments          FieldProgressItemAssignment[]
  locations            FieldProgressItemLocation[]

  @@index([projectId])
  @@index([templateId])
  @@index([parentId])
  @@index([sortOrder])
}

model ProjectLocationNode {
  id          String                  @id @default(cuid())
  projectId   String
  parentId    String?
  code        String
  name        String
  nodeType    ProjectLocationNodeType
  description String?
  level       Int                     @default(0)
  sortOrder   Int                     @default(0)
  createdById String
  updatedById String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  deletedAt   DateTime?

  project                    Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent                     ProjectLocationNode?        @relation("ProjectLocationNodeHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children                   ProjectLocationNode[]       @relation("ProjectLocationNodeHierarchy")
  createdBy                  User                        @relation("ProjectLocationNodeCreator", fields: [createdById], references: [id])
  updatedBy                  User?                       @relation("ProjectLocationNodeUpdater", fields: [updatedById], references: [id])
  documents                  Document[]
  fieldProgressEntries       FieldProgressEntry[]
  fieldProgressItemLocations FieldProgressItemLocation[]
  materialRequestItems       MaterialRequestItem[]
  siteReportLines            SiteReportLine[]

  @@unique([projectId, parentId, code])
  @@index([parentId])
  @@index([projectId, deletedAt])
  @@index([projectId, parentId, sortOrder])
}

model FieldProgressItemAssignment {
  id                  String                          @id @default(cuid())
  projectId           String
  fieldProgressItemId String
  projectMemberId     String
  role                FieldProgressItemAssignmentRole @default(RESPONSIBLE)
  note                String?
  assignedById        String
  createdAt           DateTime                        @default(now())
  updatedAt           DateTime                        @updatedAt
  deletedAt           DateTime?

  project           Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fieldProgressItem FieldProgressItem @relation(fields: [fieldProgressItemId], references: [id], onDelete: Cascade)
  projectMember     ProjectMember     @relation(fields: [projectMemberId], references: [id])
  assignedBy        User              @relation("FieldProgressItemAssignmentActor", fields: [assignedById], references: [id])

  @@unique([fieldProgressItemId, projectMemberId, role])
  @@index([fieldProgressItemId, deletedAt])
  @@index([projectId, deletedAt])
  @@index([projectMemberId, deletedAt])
}

model FieldProgressItemLocation {
  id                  String   @id @default(cuid())
  projectId           String
  fieldProgressItemId String
  locationNodeId      String
  createdById         String
  createdAt           DateTime @default(now())

  project           Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fieldProgressItem FieldProgressItem   @relation(fields: [fieldProgressItemId], references: [id], onDelete: Cascade)
  locationNode      ProjectLocationNode @relation(fields: [locationNodeId], references: [id])

  @@unique([fieldProgressItemId, locationNodeId])
  @@index([projectId, fieldProgressItemId])
  @@index([projectId, locationNodeId])
}

model FieldProgressEntry {
  id             String                   @id @default(cuid())
  projectId      String
  templateId     String
  itemId         String
  entryDate      DateTime
  quantity       Decimal                  @db.Decimal(19, 4)
  issueNote      String?
  proposalNote   String?
  note           String?
  status         FieldProgressEntryStatus @default(DRAFT)
  createdById    String
  submittedAt    DateTime?
  approvedById   String?
  approvedAt     DateTime?
  rejectedReason String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  deletedAt      DateTime?

  sourceType       String?
  sourceId         String?
  sourceLineId     String?
  sourceReportId   String?
  sourceMeta       Json?
  adjustmentReason String?
  locationNodeId   String?

  project          Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  template         FieldProgressTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  item             FieldProgressItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdBy        User                   @relation("FieldEntryCreator", fields: [createdById], references: [id])
  approvedBy       User?                  @relation("FieldEntryApprover", fields: [approvedById], references: [id])
  materialRequests FieldMaterialRequest[]
  locationNode     ProjectLocationNode?   @relation(fields: [locationNodeId], references: [id])

  @@unique([sourceReportId, sourceLineId], map: "field_progress_entry_source_report_line_uidx", where: raw("((\"deletedAt\" IS NULL) AND (\"sourceType\" = 'SITE_REPORT'::text))"))
  @@index([projectId])
  @@index([templateId])
  @@index([itemId])
  @@index([entryDate])
  @@index([sourceType, sourceId])
  @@index([sourceReportId])
  @@index([locationNodeId])
}

model FieldMaterialRequest {
  id            String                     @id @default(cuid())
  projectId     String
  templateId    String
  itemId        String
  entryId       String?
  requestDate   DateTime
  neededDate    DateTime?
  requestedById String
  status        FieldMaterialRequestStatus @default(DRAFT)
  priority      FieldMaterialPriority      @default(MEDIUM)
  note          String?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  deletedAt     DateTime?

  project     Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  template    FieldProgressTemplate      @relation(fields: [templateId], references: [id], onDelete: Cascade)
  item        FieldProgressItem          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  entry       FieldProgressEntry?        @relation(fields: [entryId], references: [id])
  requestedBy User                       @relation("FieldMaterialRequester", fields: [requestedById], references: [id])
  items       FieldMaterialRequestItem[]

  @@index([projectId])
  @@index([templateId])
  @@index([itemId])
  @@index([entryId])
}

model FieldMaterialRequestItem {
  id                String    @id @default(cuid())
  requestId         String
  materialName      String
  unit              String
  requestedQuantity Decimal   @db.Decimal(19, 4)
  reason            String?
  note              String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  request FieldMaterialRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model SystemSetting {
  id String @id @default(cuid())

  // Organization
  companyName String
  taxCode     String
  hotline     String
  timezone    String
  currency    String

  // Security
  requireTwoFactorForAdmins Boolean @default(true)
  sessionTimeoutMinutes     Int     @default(60)
  passwordRotationDays      Int     @default(90)
  allowedIpMode             String  @default("restricted")
  trustedDeviceReviewDays   Int     @default(30)
  auditSensitiveActions     Boolean @default(true)

  // Workflow
  materialRequestApproval Boolean @default(true)
  reportLockAfterApproval Boolean @default(true)

  // Documents
  enforceNamingConvention Boolean @default(true)
  autoVersioning          Boolean @default(true)
  allowedExtensions       String  @default("pdf, docx, xlsx, dwg, jpg, png, heic")
  maxUploadSizeMb         Int     @default(50)
  documentRetentionYears  Int     @default(10)

  // Notifications
  emailDailyDigest    Boolean @default(false)
  approvalEscalation  Boolean @default(true)
  fieldReportReminder Boolean @default(true)
  reminderTime        String  @default("17:30")
  escalationHours     Int     @default(24)

  // Data
  automaticBackup        Boolean @default(true)
  backupFrequency        String  @default("daily")
  retentionYears         Int     @default(7)
  exportRequiresApproval Boolean @default(true)
  maintenanceWindow      String  @default("22:00 - 23:00")

  // Metadata
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  version     Int      @default(1)

  updatedBy User? @relation("SettingUpdater", fields: [updatedById], references: [id])

  @@index([updatedById])
}

enum SupervisionFindingStatus {
  OPEN
  IN_PROGRESS
  OVERDUE
  PENDING_VERIFICATION
  REMEDIATION_FAILED
  RESOLVED
}

enum SupervisionPackageStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  REVISION_REQUIRED
  RESUBMITTED
  CONFIRMED
  LOCKED
  CANCELLED
}

enum SupervisionPlanSource {
  SUPERVISION_HEAD
  SITE_COMMANDER
  BOARD_OF_DIRECTORS
  PREVIOUS_FINDING
  CONSTRUCTION_TRANSITION
  INCIDENT
  OTHER
}

enum SupervisionRecommendationGroup {
  STAFFING
  EQUIPMENT
  WEAK_TEAM_REPLACEMENT
  PROGRESS_DIRECTION
  QUALITY_ISSUE
  TECHNICAL_VARIATION
  MATERIAL_VARIATION
  OTHER
}

enum SupervisionRemediationResult {
  NOT_CHECKED
  PASSED
  FAILED
  REWORK_REQUIRED
}

enum SupervisionScopeType {
  ALL_PROJECTS
  SELECTED_PROJECTS
}

enum SupervisionSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SupervisionShift {
  MORNING
  AFTERNOON
  EVENING
}

