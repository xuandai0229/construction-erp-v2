  inspector User                   @relation("SafetyReinspectionInspector", fields: [inspectorId], references: [id], onDelete: Restrict)

  @@index([projectId, inspectedAt])
  @@index([findingId, inspectedAt])
  @@index([actionId])
  @@index([inspectorId, inspectedAt])
}

model SafetyWeeklyReport {
  id                 String             @id @default(cuid())
  documentYear       Int
  sequenceNumber     Int?
  documentNumber     String?
  weekStart          DateTime           @db.Date
  weekEnd            DateTime           @db.Date
  status             SafetyReportStatus @default(DRAFT)
  legalBases         Json?
  recipients         Json?
  sourceSnapshotAt   DateTime?
  createdById        String
  approvedById       String?
  approvedAt         DateTime?
  cancelledAt        DateTime?
  cancellationReason String?            @db.Text
  version            Int                @default(1)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  createdBy  User                          @relation("SafetyWeeklyReportCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy User?                         @relation("SafetyWeeklyReportApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  projects   SafetyWeeklyReportProject[]
  entries    SafetyWeeklyReportEntry[]
  narratives SafetyWeeklyReportNarrative[]

  @@unique([documentYear, sequenceNumber])
  @@index([status, weekStart])
  @@index([createdById, weekStart])
}

model SafetyWeeklyReportProject {
  id        String @id @default(cuid())
  reportId  String
  projectId String

  report  SafetyWeeklyReport @relation(fields: [reportId], references: [id], onDelete: Restrict)
  project Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([reportId, projectId])
  @@index([projectId, reportId])
}

model SafetyWeeklyReportEntry {
  id                   String      @id @default(cuid())
  reportId             String
  projectId            String
  sessionId            String
  inspectionDate       DateTime    @db.Date
  shift                SafetyShift
  projectSnapshot      String
  content              String      @db.Text
  assessment           String?     @db.Text
  request              String?     @db.Text
  implementationResult String?     @db.Text
  sortOrder            Int         @default(0)
  cancelledAt          DateTime?
  cancellationReason   String?     @db.Text
  cancelledById        String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  report      SafetyWeeklyReport      @relation(fields: [reportId], references: [id], onDelete: Restrict)
  project     Project                 @relation(fields: [projectId], references: [id], onDelete: Restrict)
  session     SafetyInspectionSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  cancelledBy User?                   @relation("SafetyWeeklyReportEntryCanceller", fields: [cancelledById], references: [id], onDelete: Restrict)

  @@unique([reportId, sessionId])
  @@index([projectId, inspectionDate, shift])
  @@index([reportId, sortOrder])
  @@index([cancelledById, cancelledAt])
}

model SafetyWeeklyReportNarrative {
  id            String    @id @default(cuid())
  reportId      String
  key           String
  systemContent String    @db.Text
  editedContent String?   @db.Text
  editedById    String?
  editedAt      DateTime?
  changeReason  String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  report   SafetyWeeklyReport @relation(fields: [reportId], references: [id], onDelete: Restrict)
  editedBy User?              @relation("SafetyWeeklyNarrativeEditor", fields: [editedById], references: [id], onDelete: Restrict)

  @@unique([reportId, key])
  @@index([editedById, editedAt])
}

model SafetyDocumentTemplate {
  id                  String                     @id @default(cuid())
  templateType        SafetyDocumentTemplateType
  version             Int
  sourceFileName      String
  sourceSha256        String
  sourceSizeBytes     Int
  exportDocxFileName  String
  exportDocxSha256    String
  exportDocxSizeBytes Int
  storagePath         String
  baselinePageCount   Int
  snapshotAt          DateTime
  snapshotCreatedBy   String
  isActive            Boolean                    @default(false)
  preservesSourceText Boolean                    @default(true)
  note                String?                    @db.Text
  documentId          String?                    @unique
  createdById         String
  approvedById        String?
  approvedAt          DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  document   Document? @relation(fields: [documentId], references: [id], onDelete: Restrict)
  createdBy  User      @relation("SafetyDocumentTemplateCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy User?     @relation("SafetyDocumentTemplateApprover", fields: [approvedById], references: [id], onDelete: Restrict)

  @@unique([templateType, version])
  @@index([templateType, isActive])
  @@index([exportDocxSha256])
}

model SafetyApprovalHistory {
  id                String              @id @default(cuid())
  projectId         String?
  aggregateType     SafetyAggregateType
  aggregateId       String
  fromStatus        String?
  toStatus          String
  actorId           String
  reason            String?             @db.Text
  approvalRequestId String?
  occurredAt        DateTime            @default(now())

  project         Project?         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  actor           User             @relation("SafetyApprovalActor", fields: [actorId], references: [id], onDelete: Restrict)
  approvalRequest ApprovalRequest? @relation(fields: [approvalRequestId], references: [id], onDelete: Restrict)

  @@index([aggregateType, aggregateId, occurredAt])
  @@index([projectId, occurredAt])
  @@index([approvalRequestId])
}

model SafetyAuditLog {
  id            String              @id @default(cuid())
  projectId     String?
  aggregateType SafetyAggregateType
  aggregateId   String
  action        String
  beforeData    Json?
  afterData     Json?
  actorId       String
  occurredAt    DateTime            @default(now())
  correlationId String

  project Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)
  actor   User     @relation("SafetyAuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([aggregateType, aggregateId, occurredAt])
  @@index([projectId, occurredAt])
  @@index([actorId, occurredAt])
  @@index([correlationId])
}

model SafetyIdempotency {
  id               String              @id @default(cuid())
  actorId          String
  aggregateType    SafetyAggregateType
  aggregateId      String
  clientMutationId String
  requestHash      String
  resultData       Json?
  completedAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  actor User @relation("SafetyIdempotencyActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([actorId, aggregateType, aggregateId, clientMutationId])
  @@index([aggregateType, aggregateId, createdAt])
  @@index([actorId, createdAt])
}
