  version             Int                     @default(1)
  lockVersion         Int                     @default(1)
  submittedAt         DateTime?
  reviewedAt          DateTime?
  lockedAt            DateTime?
  createdById         String
  reviewedById        String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  deletedAt           DateTime?

  createdBy       User                              @relation("SupervisionWeeklyDossierCreator", fields: [createdById], references: [id])
  reviewedBy      User?                             @relation("SupervisionWeeklyDossierReviewer", fields: [reviewedById], references: [id])
