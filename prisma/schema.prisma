  NEXT_WEEK_PLAN
}

enum SupervisionWeeklyInputMode {
  PROJECT_WORK_ITEM
  PROJECT_MANUAL_ITEM
  MANUAL_TEXT
}

enum SupervisionWeeklyShift {
  MORNING
  AFTERNOON
  EVENING
}

enum SupervisionWeeklyDelayType {
  DAY
  PERCENT
}

model SupervisionWeeklyDossier {
  id                  String                  @id @default(cuid())
  reportNumber        String?
  weekStart           DateTime
  weekEnd             DateTime
  nextWeekStart       DateTime
  nextWeekEnd         DateTime
