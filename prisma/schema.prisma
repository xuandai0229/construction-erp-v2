  PENDING_APPROVAL
  APPROVED
  REVISION_REQUIRED
  LOCKED
  CANCELLED
}

enum SafetyScheduleStatus {
  PLANNED
  CHANGED
  CANCELLED
  IN_PROGRESS
  COMPLETED
}

enum SafetyScheduleKind {
  INSPECTION
  SURPRISE_INSPECTION
  WORKER_TRAINING
  REINSPECTION
}

enum SafetyShift {
  MORNING
  AFTERNOON
  EVENING
}

enum SafetyConstructionType {
  BUILDING
  DRAINAGE_INFRASTRUCTURE
  OTHER
}

enum SafetyInspectionStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SafetyResultStatus {
  PASS
  FAIL
  NOT_APPLICABLE
  NOT_INSPECTED
}

enum SafetySeverity {
